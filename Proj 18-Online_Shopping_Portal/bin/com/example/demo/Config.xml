<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

	<bean id="ven1" class="com.example.demo.Vendor">
	<property name="vendorId" value="111"></property>
	<property name="vendorName" value="Dell India"></property>
	<property name="contactNumber" value="9876543210"></property>
	</bean>
	
	<bean id="ven2" class="com.example.demo.Vendor">
	<property name="vendorId" value="222"></property>
	<property name="vendorName" value="JBL"></property>
	<property name="contactNumber" value="9123456780"></property>
	</bean>
	
	<bean id="ven3" class="com.example.demo.Vendor">
	<property name="vendorId" value="333"></property>
	<property name="vendorName" value="Samsung"></property>
	<property name="contactNumber" value="9990011223"></property>
	</bean>
	
	<bean id="ven4" class="com.example.demo.Vendor">
	<property name="vendorId" value="444"></property>
	<property name="vendorName" value="Mi Electronics"></property>
	<property name="contactNumber" value="9988776655"></property>
	</bean>
	
	<bean id="prod1" class="com.example.demo.Product">
	<property name="productId" value="100"></property>
	<property name="productName" value="Laptop"></property>
	<property name="price" value="55000"></property>
	</bean>
	
	
	<bean id="prod2" class="com.example.demo.Product">
	<property name="productId" value="200"></property>
	<property name="productName" value="Headphones"></property>
	<property name="price" value="2500"></property>
	</bean>
	
		<bean id="prod3" class="com.example.demo.Product">
	<property name="productId" value="300"></property>
	<property name="productName" value="Smartwatch"></property>
	<property name="price" value="8000"></property>
	</bean>
	
	
		<bean id="prod4" class="com.example.demo.Product">
	<property name="productId" value="400"></property>
	<property name="productName" value="Power Bank"></property>
	<property name="price" value="1500"></property>
	</bean>
	
	
	<bean id="scart1" class="com.example.demo.ShoppingCart">
	<property name="cartOwner" value="Meera"></property>
	<property name="productVendorMap">
	<map>
	<entry key-ref="prod1" value-ref="ven1"></entry>
	<entry key-ref="prod2" value-ref="ven2"></entry>
	</map>
	</property>
	</bean>
	
	<bean id="scart2" class="com.example.demo.ShoppingCart">
	<property name="cartOwner" value="Meera"></property>
	<property name="productVendorMap">
	<map>
	<entry key-ref="prod3" value-ref="ven3"></entry>
	<entry key-ref="prod4" value-ref="ven4"></entry>
	</map>
	</property>
	</bean>
	
	<bean id="ecp" class="com.example.demo.ECommercePlatform">
	<property name="platformName" value="ShopNow"></property>
	<property name="carts">
	<list>
	<ref bean="scart1"/>
	<ref bean="scart2"/>
	</list>
	</property>
	</bean>
	
	
</beans>
